---
import BaseLayout from './BaseLayout.astro';
const { frontmatter, editUrl } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pubDate = new Date(frontmatter.pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const [titleZh, titleEn] = frontmatter.title.split('|').map((s: string) => s.trim());

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": frontmatter.title,
  "description": frontmatter.description,
  "datePublished": new Date(frontmatter.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": frontmatter.author || "Zen",
    "url": "https://zenhome.qzz.io/about"
  },
  "publisher": {
    "@type": "Person",
    "name": "Zen"
  },
  "keywords": (frontmatter.tags || []).join(', '),
  "inLanguage": "zh-CN"
});
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} type="article">
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-14">

    <!-- Dev: edit button -->
    {editUrl && (
      <a href={editUrl}
        class="fixed bottom-6 right-6 z-50 inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-semibold bg-gray-900 dark:bg-white text-white dark:text-gray-900 shadow-lg hover:opacity-80 active:scale-95 transition-all duration-150"
        title="在 VS Code 中编辑">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        编辑
      </a>
    )}

    <!-- Back -->
    <a href={`${base}blog`} class="inline-flex items-center gap-1.5 text-sm text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 mb-12 transition-colors group">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      返回博客
    </a>

    <!-- Article Header -->
    <header class="mb-12">
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-5">
          {frontmatter.tags.map((tag: string) => (
            <span class="text-[11px] font-semibold px-2.5 py-1 rounded bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 tracking-wide">
              {tag}
            </span>
          ))}
        </div>
      )}
      <h1 class="font-bold leading-tight tracking-tight mb-5">
        <span class="block text-3xl sm:text-4xl text-gray-900 dark:text-white">{titleZh}</span>
        {titleEn && (
          <span class="block text-xl sm:text-2xl text-gray-400 dark:text-gray-500 font-medium mt-2 tracking-normal">{titleEn}</span>
        )}
      </h1>
      <div class="flex items-center gap-2 text-sm text-gray-400 dark:text-gray-500">
        <span>{pubDate}</span>
        <span class="text-gray-300 dark:text-gray-700">·</span>
        <span>{frontmatter.author || 'Zen'}</span>
        <span class="text-gray-300 dark:text-gray-700">·</span>
        <span id="reading-time">阅读中…</span>
      </div>
    </header>

    <div class="prose-zen">
      <slot />
    </div>

    <!-- Share Bar -->
    <div class="mt-16 pt-8 border-t border-gray-100 dark:border-white/[0.06]">
      <p class="text-xs font-medium text-gray-400 dark:text-gray-500 tracking-wider uppercase mb-4">分享文章</p>
      <div class="flex flex-wrap items-center gap-2">
        <!-- Copy Link -->
        <button
          id="share-copy"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-sm font-medium border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-400 hover:border-gray-400 dark:hover:border-white/20 hover:text-gray-800 dark:hover:text-gray-200 transition-all duration-150"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          复制链接
        </button>

        <!-- X -->
        <a id="share-x" href="#" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-sm font-medium border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-400 hover:border-gray-400 dark:hover:border-white/20 hover:text-gray-800 dark:hover:text-gray-200 transition-all duration-150">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.736-8.836L2.25 2.25h6.978l4.259 5.632 4.757-5.632zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
          </svg>
          X
        </a>

        <!-- Weibo -->
        <a id="share-weibo" href="#" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-sm font-medium border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-400 hover:border-gray-400 dark:hover:border-white/20 hover:text-gray-800 dark:hover:text-gray-200 transition-all duration-150">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M10.098 20.323c-3.977.391-7.414-1.406-7.672-4.02-.259-2.609 2.759-5.047 6.74-5.441 3.979-.394 7.413 1.404 7.671 4.018.259 2.6-2.759 5.049-6.739 5.443zm5.83-9.927c-.268-.083-.452-.14-.312-.504.31-.778.342-1.447.005-1.926-.63-.892-2.354-.845-4.328-.005 0 0-.621.27-.462-.22.303-.97.258-1.783-.213-2.254-1.073-1.073-3.927.041-6.384 2.498-1.84 1.84-2.906 3.765-2.906 5.438 0 3.205 4.11 5.155 8.133 5.155 5.27 0 8.775-3.062 8.775-5.49 0-1.468-1.238-2.305-2.308-2.692zm-1.95-6.564c-.228.063-.457.128-.677.2-.225.071-.433-.044-.504-.27-.07-.225.044-.468.27-.539.244-.077.49-.152.737-.218.25-.068.505-.127.761-.178.256-.05.481.116.53.37.05.255-.115.48-.369.529-.25.048-.499.106-.748.106zm.85-2.45c-.657.18-1.308.379-1.953.589-.224.074-.468-.046-.543-.27-.075-.225.045-.469.27-.543.659-.215 1.325-.418 1.997-.602.268-.072.541.085.613.351.072.268-.085.541-.384.475zm4.27 1.394c-.47-1.306-1.59-2.258-2.991-2.637-1.048-.282-2.131-.197-3.078.24-.255.12-.538.01-.657-.246-.12-.255-.009-.54.246-.659 1.178-.557 2.536-.664 3.838-.303 1.745.471 3.14 1.701 3.738 3.299.097.262-.035.552-.297.647-.262.097-.551-.033-.649-.295l-.15-.046z"/>
          </svg>
          微博
        </a>

        <!-- WeChat -->
        <button id="share-wechat"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-sm font-medium border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-400 hover:border-gray-400 dark:hover:border-white/20 hover:text-gray-800 dark:hover:text-gray-200 transition-all duration-150">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.278 1.786-1.533 1.273-2.305 3.160-1.633 5.428.716 2.4 3.064 3.921 5.554 3.921.896 0 1.785-.159 2.621-.464a.61.61 0 0 1 .527.071l1.394.816a.232.232 0 0 0 .12.036c.115 0 .211-.096.211-.213 0-.051-.022-.1-.033-.15l-.288-1.083a.42.42 0 0 1 .157-.486C21.35 17.418 22.5 15.79 22.5 13.985c.001-2.896-2.555-5.158-5.562-5.127zm-2.559 2.623c.471 0 .853.388.853.865a.86.86 0 0 1-.853.865.86.86 0 0 1-.853-.865c0-.477.382-.865.853-.865zm5.116 0c.471 0 .853.388.853.865a.86.86 0 0 1-.853.865.86.86 0 0 1-.853-.865c0-.477.382-.865.853-.865z"/>
          </svg>
          微信
        </button>
      </div>
    </div>

    <!-- Giscus -->
    <div class="mt-16 pt-10 border-t border-gray-100 dark:border-white/[0.06]">
      <h2 class="text-xs font-semibold text-gray-400 dark:text-gray-500 tracking-wider uppercase mb-6">评论</h2>
      <script src="https://giscus.app/client.js"
        data-repo="ZouHongxue/ZenBlog"
        data-repo-id="MDEwOlJlcG9zaXRvcnkxMDg5NDAyMTU="
        data-category="Announcements"
        data-category-id="DIC_kwDOBn5Lt84C9G_u"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        crossorigin="anonymous"
        async>
      </script>
    </div>
  </article>

  <!-- WeChat QR Modal -->
  <div id="wechat-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div id="wechat-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <div class="relative bg-white dark:bg-[#1a1a1c] rounded-2xl shadow-2xl p-8 flex flex-col items-center gap-4 max-w-xs w-full border border-gray-100 dark:border-white/10">
      <button id="wechat-close" class="absolute top-3 right-3 p-1.5 rounded-md text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors" aria-label="关闭">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <p class="text-sm font-semibold text-gray-700 dark:text-gray-200">微信扫码分享</p>
      <div id="wechat-qr" class="rounded-xl overflow-hidden bg-white p-2"></div>
      <p class="text-xs text-gray-400 dark:text-gray-500 text-center leading-relaxed">
        用微信扫一扫，分享此文章
      </p>
    </div>
  </div>
  <script type="application/ld+json" set:html={jsonLd} />
</BaseLayout>

<script>
  const pageUrl = window.location.href;
  const pageTitle = document.title;

  // Copy link
  const copyBtn = document.getElementById('share-copy');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pageUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = pageUrl;
        ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); document.body.removeChild(ta);
      }
      const orig = copyBtn.innerHTML;
      copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> 已复制`;
      copyBtn.classList.add('border-emerald-300', 'text-emerald-600', 'dark:border-emerald-700', 'dark:text-emerald-400');
      setTimeout(() => {
        copyBtn.innerHTML = orig;
        copyBtn.classList.remove('border-emerald-300', 'text-emerald-600', 'dark:border-emerald-700', 'dark:text-emerald-400');
      }, 2000);
    });
  }

  // Weibo
  const weiboLink = document.getElementById('share-weibo') as HTMLAnchorElement | null;
  if (weiboLink) weiboLink.href = `https://service.weibo.com/share/share.php?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(pageTitle)}`;

  // X
  const xLink = document.getElementById('share-x') as HTMLAnchorElement | null;
  if (xLink) xLink.href = `https://x.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle)}`;

  // WeChat QR
  const wechatBtn = document.getElementById('share-wechat');
  const modal = document.getElementById('wechat-modal');
  const backdrop = document.getElementById('wechat-backdrop');
  const closeBtn = document.getElementById('wechat-close');
  const qrContainer = document.getElementById('wechat-qr');
  let qrGenerated = false;

  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden'); modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    if (!qrGenerated && qrContainer) {
      const s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
      s.onload = () => {
        // @ts-ignore
        new QRCode(qrContainer, { text: pageUrl, width: 180, height: 180, colorDark: '#111827', colorLight: '#ffffff', correctLevel: 3 });
        qrGenerated = true;
      };
      document.head.appendChild(s);
    }
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden'); modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  wechatBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Reading time
  const articleText = document.querySelector('.prose-zen')?.textContent || '';
  const minutes = Math.max(1, Math.ceil(articleText.trim().length / 400));
  const rtEl = document.getElementById('reading-time');
  if (rtEl) rtEl.textContent = `约 ${minutes} 分钟`;
</script>
