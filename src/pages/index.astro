---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const recentPosts = posts.slice(0, 5);

// 标签统计
const tagMap: Record<string, number> = {};
posts.forEach(p => (p.data.tags || []).forEach((t: string) => {
  tagMap[t] = (tagMap[t] || 0) + 1;
}));
const tags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="首页">
  <!-- Hero -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 pt-20 pb-14">
    <div class="flex items-center gap-2 mb-6">
      <span class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse"></span>
      <span class="text-sm text-gray-500 dark:text-gray-400">正在创作中</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white leading-tight mb-6">
      你好，我是 <span class="text-indigo-600 dark:text-indigo-400">Zen</span> 👋
    </h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed mb-8 max-w-2xl">
      这里是我记录想法、分享技术与生活的地方。写下来的东西，才真正属于自己。
    </p>
    <div class="flex flex-wrap gap-3">
      <a href={`${base}blog`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm transition-all hover:shadow-lg hover:shadow-indigo-500/25">
        浏览文章
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a href={`${base}about`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-gray-300 dark:border-gray-700 hover:border-indigo-400 dark:hover:border-indigo-600 text-gray-700 dark:text-gray-300 font-medium text-sm transition-all">
        了解我
      </a>
    </div>
  </section>

  <!-- 文章 + 标签索引 -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-20 grid grid-cols-1 sm:grid-cols-3 gap-10">

    <!-- Recent Posts -->
    <section class="sm:col-span-2">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white">最新文章</h2>
        <a href={`${base}blog`} class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline">全部 →</a>
      </div>
      <div class="space-y-3">
        {recentPosts.map(post => {
          const date = new Date(post.data.pubDate).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
          return (
            <a href={`${base}blog/${post.slug}`}
              class="group flex items-start gap-3 p-4 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-indigo-300 dark:hover:border-indigo-700 bg-white dark:bg-gray-900/40 hover:bg-indigo-50/20 dark:hover:bg-indigo-950/20 transition-all">
              <time class="text-xs text-gray-400 dark:text-gray-500 shrink-0 mt-1 w-14">{date}</time>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-medium text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
                  {post.data.title}
                </h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 line-clamp-1">{post.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Tag Index -->
    <section>
      <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-6">标签索引</h2>
      <div class="flex flex-col gap-1">
        {tags.map(([tag, count]) => (
          <a href={`${base}blog?tag=${encodeURIComponent(tag)}`}
            class="group flex items-center justify-between px-3 py-2 rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-950/40 transition-colors">
            <span class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              # {tag}
            </span>
            <span class="text-xs text-gray-400 dark:text-gray-500">{count}</span>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
