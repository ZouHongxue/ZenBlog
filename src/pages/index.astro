---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const isDev = import.meta.env.DEV;

// 素材库（仅 dev）
let ideas: Array<{date: string; text: string; context: string; tags: string[]}> = [];
if (isDev) {
  try {
    const raw = await import('../data/ideas.json');
    ideas = (raw.default ?? raw) as typeof ideas;
  } catch {}
}

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const recentPosts = posts.slice(0, 5);

const tagMap: Record<string, number> = {};
posts.forEach(p => (p.data.tags || []).forEach((t: string) => {
  tagMap[t] = (tagMap[t] || 0) + 1;
}));
const tags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);

const drafts = isDev
  ? (await getCollection('blog', ({ data }) => !!data.draft)).sort(
      (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    )
  : [];

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="首页">

  <!-- Hero -->
  <section class="relative max-w-4xl mx-auto px-4 sm:px-6 pt-16 pb-16 overflow-hidden">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-100 dark:bg-indigo-950/30 rounded-full blur-3xl opacity-40 dark:opacity-20 pointer-events-none"></div>
    <div class="relative reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200/80 dark:border-emerald-800/50 mb-7">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-xs font-medium text-emerald-700 dark:text-emerald-400 tracking-wide">正在创作中</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white leading-[1.15] tracking-tight mb-5">
        你好，我是 <span class="text-indigo-600 dark:text-indigo-400">Zen</span>
      </h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 leading-relaxed mb-9 max-w-md">
        这里是我记录想法、分享技术与生活的地方。<br class="hidden sm:block"/>写下来的东西，才真正属于自己。
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={`${base}blog`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-indigo-600 hover:bg-indigo-700 active:scale-[0.98] text-white font-semibold text-sm transition-all duration-200 shadow-sm shadow-indigo-200 dark:shadow-none">
          浏览文章
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a href={`${base}about`}
          class="inline-flex items-center px-5 py-2.5 rounded-full border border-gray-300 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/5 hover:border-gray-400 dark:hover:border-white/20 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white font-medium text-sm transition-all duration-200">
          关于我
        </a>
      </div>
    </div>
  </section>

  <!-- 分隔线 -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <hr class="border-gray-100 dark:border-white/[0.06]" />
  </div>

  <!-- 文章列表 + 标签 -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-16 grid grid-cols-1 sm:grid-cols-4 gap-10 items-start">

    <!-- 左列：最新文章（卡片式） -->
    <div class="sm:col-span-3">
      <div class="border border-dashed border-indigo-200 dark:border-indigo-800/40 rounded-xl p-5">
        <div class="flex items-center justify-between mb-4 reveal">
          <span class="text-xs font-semibold text-indigo-500 dark:text-indigo-400 tracking-wider uppercase">最新文章</span>
          <a href={`${base}blog`} class="text-xs text-gray-400 dark:text-gray-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">全部 →</a>
        </div>
        <div class="divide-y divide-gray-100 dark:divide-white/[0.06]">
          {recentPosts.map((post, i) => {
            const date = new Date(post.data.pubDate).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
            const url = `${base}blog/${post.slug}`;
            return (
              <div class={`group relative flex items-start gap-4 py-3 rounded-lg hover:bg-indigo-50/50 dark:hover:bg-indigo-950/20 transition-all duration-150 reveal reveal-delay-${Math.min(i + 1, 5)}`}>
                <time class="text-xs text-gray-400 dark:text-gray-600 shrink-0 w-12 tabular-nums pt-0.5">{date}</time>
                <a href={url} class="flex-1 min-w-0 pr-2">
                  <h3 class="text-[15px] font-medium text-gray-800 dark:text-gray-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-150 truncate">
                    {post.data.title}
                  </h3>
                  <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5 line-clamp-1">{post.data.description}</p>
                </a>
                <button
                  class="share-card-btn opacity-0 group-hover:opacity-100 absolute right-1 top-1/2 -translate-y-1/2 p-1.5 rounded-md text-gray-400 hover:text-indigo-500 dark:hover:text-indigo-400 hover:bg-indigo-100 dark:hover:bg-indigo-950/40 transition-all duration-150"
                  data-url={url} title="复制链接" aria-label="复制链接">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                  </svg>
                </button>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- 右列：标签 -->
    <aside class="sticky top-20 self-start reveal reveal-delay-2 border-l border-gray-100 dark:border-white/[0.06] pl-5">
      <h2 class="text-xs font-semibold text-gray-400 dark:text-gray-500 tracking-wider uppercase mb-3">标签</h2>
      <div class="flex flex-col">
        {tags.map(([tag, count]) => (
          <a href={`${base}blog?tag=${encodeURIComponent(tag)}`}
            class="group flex items-center justify-between py-1.5 border-b border-gray-100 dark:border-white/[0.05] last:border-0 transition-colors">
            <span class="text-sm text-gray-500 dark:text-gray-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-150">{tag}</span>
            <span class="text-xs text-gray-300 dark:text-gray-600 tabular-nums">{count}</span>
          </a>
        ))}
      </div>
    </aside>

  </div>

  <!-- Dev: 素材库 -->
  {isDev && (
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-6">
      <div id="ideas-panel" class="border border-dashed border-violet-300 dark:border-violet-700/50 rounded-xl p-5">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-semibold text-violet-600 dark:text-violet-400 tracking-wider uppercase">素材库 · 仅本地可见</span>
          <button id="ideas-add-btn" class="text-xs text-violet-500 dark:text-violet-400 hover:text-violet-700 dark:hover:text-violet-300 transition-colors">+ 添加</button>
        </div>

        <!-- 条目列表 -->
        <div id="ideas-list" class="divide-y divide-violet-100 dark:divide-violet-900/30">
          {ideas.map((idea, idx) => (
            <div class="idea-item py-2.5 flex items-start gap-3 group/idea" data-idx={idx}>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">{idea.text}</p>
                {idea.context && <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">{idea.context}</p>}
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-xs text-gray-300 dark:text-gray-600 tabular-nums">
                    {new Date(idea.date).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}
                  </span>
                  {idea.tags.map(tag => <span class="text-xs text-violet-300 dark:text-violet-700">#{tag}</span>)}
                </div>
              </div>
              <button class="idea-delete opacity-0 group-hover/idea:opacity-100 shrink-0 p-1 text-gray-300 dark:text-gray-600 hover:text-red-400 transition-all" data-idx={idx} title="删除">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>
          ))}
        </div>

        <!-- 添加表单（默认隐藏） -->
        <div id="ideas-form" class="hidden mt-4 pt-4 border-t border-violet-100 dark:border-violet-900/30">
          <textarea id="ideas-text" placeholder="记录想法、句子、灵感…" rows="2"
            class="w-full text-sm text-gray-700 dark:text-gray-300 bg-violet-50/50 dark:bg-violet-950/20 border border-violet-200 dark:border-violet-800/50 rounded-lg px-3 py-2 resize-none focus:outline-none focus:border-violet-400 dark:focus:border-violet-600 transition-colors mb-2 placeholder-gray-400 dark:placeholder-gray-600"></textarea>
          <input id="ideas-context" type="text" placeholder="背景信息（可选）"
            class="w-full text-sm text-gray-700 dark:text-gray-300 bg-violet-50/50 dark:bg-violet-950/20 border border-violet-200 dark:border-violet-800/50 rounded-lg px-3 py-1.5 focus:outline-none focus:border-violet-400 dark:focus:border-violet-600 transition-colors mb-2 placeholder-gray-400 dark:placeholder-gray-600" />
          <input id="ideas-tags" type="text" placeholder="标签（逗号分隔，如：随想,旅行）"
            class="w-full text-sm text-gray-700 dark:text-gray-300 bg-violet-50/50 dark:bg-violet-950/20 border border-violet-200 dark:border-violet-800/50 rounded-lg px-3 py-1.5 focus:outline-none focus:border-violet-400 dark:focus:border-violet-600 transition-colors mb-3 placeholder-gray-400 dark:placeholder-gray-600" />
          <div class="flex gap-2">
            <button id="ideas-save" class="px-4 py-1.5 rounded-md bg-violet-600 hover:bg-violet-700 text-white text-xs font-semibold transition-colors">保存</button>
            <button id="ideas-cancel" class="px-4 py-1.5 rounded-md text-violet-500 dark:text-violet-400 hover:bg-violet-50 dark:hover:bg-violet-950/30 text-xs transition-colors">取消</button>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Dev: 草稿 -->
  {isDev && drafts.length > 0 && (
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
      <div class="border border-dashed border-amber-300 dark:border-amber-700/60 rounded-xl p-5">
        <p class="text-xs font-semibold text-amber-600 dark:text-amber-500 tracking-wider uppercase mb-3">草稿 · 仅本地可见</p>
        <div class="divide-y divide-amber-100 dark:divide-amber-900/30">
          {drafts.map(post => (
            <a href={`${base}blog/${post.slug}`} class="flex items-center gap-4 py-2.5 group">
              <span class="text-xs text-amber-400 dark:text-amber-600 shrink-0 tabular-nums">
                {new Date(post.data.pubDate).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}
              </span>
              <span class="text-sm text-gray-600 dark:text-gray-400 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">{post.data.title}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  // Share buttons
  document.querySelectorAll<HTMLButtonElement>('.share-card-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault(); e.stopPropagation();
      const url = btn.dataset.url ?? window.location.href;
      const absUrl = new URL(url, window.location.origin).href;
      try { await navigator.clipboard.writeText(absUrl); }
      catch {
        const ta = document.createElement('textarea');
        ta.value = absUrl; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
      }
      const orig = btn.innerHTML;
      btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`;
      btn.classList.add('opacity-100');
      setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('opacity-100'); }, 1500);
    });
  });

  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); } }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // 素材库编辑器
  const addBtn = document.getElementById('ideas-add-btn');
  const form = document.getElementById('ideas-form');
  const saveBtn = document.getElementById('ideas-save');
  const cancelBtn = document.getElementById('ideas-cancel');
  const textEl = document.getElementById('ideas-text') as HTMLTextAreaElement | null;
  const contextEl = document.getElementById('ideas-context') as HTMLInputElement | null;
  const tagsEl = document.getElementById('ideas-tags') as HTMLInputElement | null;

  if (addBtn && form) {
    addBtn.addEventListener('click', () => { form.classList.toggle('hidden'); textEl?.focus(); });
    cancelBtn?.addEventListener('click', () => { form.classList.add('hidden'); if(textEl) textEl.value=''; if(contextEl) contextEl.value=''; if(tagsEl) tagsEl.value=''; });

    saveBtn?.addEventListener('click', async () => {
      const text = textEl?.value.trim();
      if (!text) return;
      const context = contextEl?.value.trim() || '';
      const tags = tagsEl?.value.split(',').map(t => t.trim()).filter(Boolean);
      const today = new Date().toISOString().slice(0, 10);

      const res = await fetch('/api/ideas');
      const current = await res.json();
      current.push({ date: today, text, context, tags: tags?.length ? tags : ['随想'] });

      await fetch('/api/ideas', { method: 'POST', body: JSON.stringify(current, null, 2) });
      window.location.reload();
    });

    // Delete buttons
    document.querySelectorAll<HTMLButtonElement>('.idea-delete').forEach(btn => {
      btn.addEventListener('click', async () => {
        const idx = parseInt(btn.dataset.idx!);
        const res = await fetch('/api/ideas');
        const current = await res.json();
        current.splice(idx, 1);
        await fetch('/api/ideas', { method: 'POST', body: JSON.stringify(current, null, 2) });
        window.location.reload();
      });
    });
  }
</script>
