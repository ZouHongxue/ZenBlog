---
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const dir = join(process.cwd(), 'src/data/zhuanti');
  const files = readdirSync(dir).filter(f => f.endsWith('.html'));
  return files.map(f => ({ params: { slug: f.replace('.html', '') } }));
}

const { slug } = Astro.params;
const dir = join(process.cwd(), 'src/data/zhuanti');
let rawHtml = readFileSync(join(dir, `${slug}.html`), 'utf-8');

// 提取标题
const titleMatch = rawHtml.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
const pageTitle = titleMatch ? titleMatch[1].replace(/<[^>]+>/g, '').trim() : slug;

// 注入高度上报脚本
const heightScript = `
<script>
(function() {
  function send() {
    var h = Math.max(
      document.documentElement.scrollHeight,
      document.documentElement.offsetHeight,
      document.body ? document.body.scrollHeight : 0
    );
    parent.postMessage({ type: 'zhuanti-h', h: h }, '*');
  }
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(function() { send(); setTimeout(send, 200); });
  }
  window.addEventListener('load', function() { send(); setTimeout(send, 500); });
  if (window.ResizeObserver && document.body) {
    new ResizeObserver(send).observe(document.body);
  }
})();
<\/script>
`;
rawHtml = rawHtml.replace(/<\/body>/i, heightScript + '</body>');

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    /* 顶部细栏 */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      height: 40px;
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid #f0f0f0;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 0 16px;
      flex-shrink: 0;
    }
    .topbar a {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      color: #9ca3af;
      text-decoration: none;
      transition: color 0.15s;
    }
    .topbar a:hover { color: #6366f1; }
    .topbar .sep { color: #e5e7eb; font-size: 10px; }
    .topbar .cur { font-size: 12px; color: #9ca3af; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* iframe 全宽撑满 */
    #zhuanti-frame {
      width: 100%;
      border: none;
      display: block;
      min-height: calc(100vh - 40px);
    }
  </style>
</head>
<body>

  <div class="topbar">
    <a href={`${base}zhuanti`}>
      <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      专题
    </a>
    <span class="sep">·</span>
    <span class="cur">{pageTitle}</span>
  </div>

  <iframe
    id="zhuanti-frame"
    srcdoc={rawHtml}
    title={pageTitle}
    scrolling="no"
  />

  <script>
    window.addEventListener('message', function(e) {
      if (!e.data || e.data.type !== 'zhuanti-h') return;
      var frame = document.getElementById('zhuanti-frame');
      if (frame && e.data.h > 0) {
        var cur = parseInt(frame.style.height) || 0;
        if (e.data.h > cur) frame.style.height = e.data.h + 'px';
      }
    });
  </script>

</body>
</html>
