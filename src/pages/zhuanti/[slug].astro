---
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const dir = join(process.cwd(), 'src/data/zhuanti');
  const files = readdirSync(dir).filter(f => f.endsWith('.html'));
  return files.map(f => ({ params: { slug: f.replace('.html', '') } }));
}

const { slug } = Astro.params;
const dir = join(process.cwd(), 'src/data/zhuanti');
const rawHtml = readFileSync(join(dir, `${slug}.html`), 'utf-8');

// 提取标题
const titleMatch = rawHtml.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
const pageTitle = titleMatch ? titleMatch[1].replace(/<[^>]+>/g, '').trim() : slug;

// 提取所有 <style> 标签
const styles = [...rawHtml.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/gi)]
  .map(m => m[1]).join('\n');

// 提取 <body> 内容（或整个文档去掉 head）
const bodyMatch = rawHtml.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
const bodyContent = bodyMatch ? bodyMatch[1] : rawHtml.replace(/<head[\s\S]*?<\/head>/i, '').replace(/<\/?html[^>]*>/gi, '').replace(/<\/?body[^>]*>/gi, '');

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    /* 顶部细栏 */
    #zhuanti-topbar {
      position: sticky;
      top: 0;
      z-index: 9999;
      height: 40px;
      background: rgba(15,15,16,0.85);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 0 16px;
    }
    #zhuanti-topbar a {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #6b7280;
      text-decoration: none;
      transition: color 0.15s;
    }
    #zhuanti-topbar a:hover { color: #a5b4fc; }
    #zhuanti-topbar .sep { color: rgba(255,255,255,0.15); font-size: 10px; }
    #zhuanti-topbar .cur {
      font-size: 12px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #6b7280;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  </style>
  <!-- 原始 HTML 的样式 -->
  <style set:html={styles} />
</head>
<body>

  <!-- 导航栏 -->
  <div id="zhuanti-topbar">
    <a href={`${base}zhuanti`}>
      <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      专题
    </a>
    <span class="sep">·</span>
    <span class="cur">{pageTitle}</span>
  </div>

  <!-- 原始 HTML body 内容直接注入，正常滚动 -->
  <Fragment set:html={bodyContent} />

</body>
</html>
