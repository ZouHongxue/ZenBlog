---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join } from 'path';

const zhuantiDir = join(process.cwd(), 'src/data/zhuanti');
const files = existsSync(zhuantiDir)
  ? readdirSync(zhuantiDir).filter(f => f.endsWith('.html')).sort().reverse()
  : [];

function parseMeta(filename: string) {
  try {
    const html = readFileSync(join(zhuantiDir, filename), 'utf-8');
    // <title>
    const titleMatch = html.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
    const title = titleMatch
      ? titleMatch[1].replace(/<[^>]+>/g, '').trim()
      : filename.replace('.html', '');
    // <meta name="description">
    const descMatch = html.match(/<meta[^>]*name=["']description["'][^>]*content=["']([^"']*)["']/i)
      || html.match(/<meta[^>]*content=["']([^"']*)["'][^>]*name=["']description["']/i);
    const desc = descMatch ? descMatch[1].trim() : '';
    // 第一段文本作为摘要备选
    const pMatch = html.match(/<p[^>]*>([\s\S]*?)<\/p>/i);
    const excerpt = desc || (pMatch ? pMatch[1].replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim().slice(0, 120) : '');
    return { title, excerpt };
  } catch {
    return { title: filename.replace('.html', ''), excerpt: '' };
  }
}

const items = files.map(f => ({
  slug: f.replace('.html', ''),
  filename: f,
  ...parseMeta(f),
}));

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="专题" description="深度专题研究与分析文章。">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14">

    <div class="mb-10">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold text-indigo-500 tracking-wider uppercase">In Depth</span>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight">专题</h1>
      <p class="text-sm text-gray-400 dark:text-gray-500 mt-2">深度研究与专题分析。</p>
    </div>

    {items.length === 0 ? (
      <div class="text-center py-20 text-gray-400 dark:text-gray-600 text-sm">暂无专题</div>
    ) : (
      <div class="divide-y divide-gray-100 dark:divide-white/[0.06]">
        {items.map((item, i) => (
          <a
            href={`${base}zhuanti/${item.slug}`}
            class="group flex items-start gap-5 py-6 hover:bg-indigo-50/40 dark:hover:bg-indigo-950/10 -mx-3 px-3 rounded-xl transition-colors">

            <!-- 序号 -->
            <div class="shrink-0 w-10 text-center pt-0.5">
              <div class="text-xl font-bold text-indigo-400 dark:text-indigo-600 tabular-nums leading-none">
                {String(items.length - i).padStart(2, '0')}
              </div>
            </div>

            <!-- 内容 -->
            <div class="flex-1 min-w-0">
              <h2 class="text-base font-semibold text-gray-800 dark:text-gray-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug mb-1">
                {item.title}
              </h2>
              {item.excerpt && (
                <p class="text-sm text-gray-500 dark:text-gray-500 line-clamp-2 leading-relaxed">{item.excerpt}</p>
              )}
            </div>

            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 dark:text-gray-700 group-hover:text-indigo-400 shrink-0 mt-1 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
