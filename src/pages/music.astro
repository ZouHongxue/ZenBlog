---
import BaseLayout from '../layouts/BaseLayout.astro';
import songsData from '../data/songs.json';
const songs = songsData as Array<{
  id: string; title: string; artist: string; album: string; year: string;
  youtubeId: string; note: string; lyrics: string;
}>;
---

<BaseLayout title="在听" description="最近在循环的一些歌。">

  <!-- 播放器覆盖层 -->
  <div id="music-overlay"
    class="fixed inset-0 z-50 hidden flex-col items-center justify-center"
    style="background: rgba(12,12,14,0.97); backdrop-filter: blur(20px);">

    <!-- 返回 -->
    <button id="overlay-close"
      class="absolute top-6 left-6 inline-flex items-center gap-1.5 text-xs text-gray-500 hover:text-gray-300 transition-colors group">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      返回列表
    </button>

    <!-- 歌曲信息 -->
    <div class="absolute top-5 right-6 text-right">
      <p id="overlay-title" class="text-sm font-medium text-white/80"></p>
      <p id="overlay-artist" class="text-xs text-gray-600 mt-0.5"></p>
    </div>

    <!-- 歌词滚动窗口 -->
    <div id="lyrics-window"
      class="w-full overflow-hidden"
      style="max-width: 480px; height: 320px; mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);">
      <div id="lyrics-inner" style="transition: transform 0.45s cubic-bezier(0.4,0,0.2,1); padding-top: 140px; padding-bottom: 140px;">
        <!-- 歌词行由 JS 注入 -->
      </div>
    </div>

    <!-- YouTube 播放器 + 翻页 -->
    <div class="mt-6 flex flex-col items-center gap-3">
      <div class="rounded-xl overflow-hidden" style="width: 280px; height: 158px; background: #000;">
        <div id="yt-player"></div>
      </div>
      <div class="flex items-center gap-5 mt-1">
        <button id="prev-song" class="text-gray-600 hover:text-gray-300 transition-colors disabled:opacity-20 disabled:cursor-not-allowed">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7M5 19V5"/>
          </svg>
        </button>
        <button id="next-song" class="text-gray-600 hover:text-gray-300 transition-colors disabled:opacity-20 disabled:cursor-not-allowed">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7M19 5v14"/>
          </svg>
        </button>
      </div>
      {import.meta.env.DEV && (
        <button id="lrc-edit-toggle"
          title="调整歌词时间轴"
          class="mt-1 text-xs text-gray-700 hover:text-violet-400 transition-colors flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>
          </svg>
          调时间轴
        </button>
      )}
    </div>
  </div>

  {import.meta.env.DEV && (
    <!-- LRC 编辑面板：固定在覆盖层右侧 -->
    <div id="lrc-dev-panel" style="
      position:fixed; top:0; right:0; bottom:0; width:320px; z-index:60;
      background:rgba(10,10,12,0.97); border-left:1px solid rgba(255,255,255,0.08);
      display:none; flex-direction:column; backdrop-filter:blur(10px);
    ">
      <!-- 面板头 -->
      <div style="padding:12px 14px; border-bottom:1px solid rgba(255,255,255,0.07); display:flex; align-items:center; gap:10px; flex-shrink:0;">
        <span style="font-size:10px;font-weight:700;color:#555;letter-spacing:.1em;text-transform:uppercase;">LRC 校对</span>
        <span id="lrc-song-label" style="font-size:12px;color:#888;flex:1;"></span>
        <span id="lrc-time-now" style="font-family:monospace;font-size:13px;font-weight:600;color:#a78bfa;min-width:72px;text-align:right;">0:00.0</span>
      </div>
      <!-- 偏移 -->
      <div style="padding:8px 12px; border-bottom:1px solid rgba(255,255,255,0.07); display:flex; align-items:center; gap:6px; flex-shrink:0;">
        <span style="font-size:11px;color:#555;">整体偏移</span>
        <button id="lrc-off-minus" style="width:22px;height:22px;border-radius:4px;border:1px solid rgba(255,255,255,0.1);background:none;color:#888;font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;">−</button>
        <input id="lrc-offset" type="number" value="0" step="0.1"
          style="width:60px;padding:3px 6px;background:#1a1a1e;border:1px solid rgba(255,255,255,0.1);border-radius:5px;color:#e8e8ea;font-size:12px;font-family:monospace;text-align:center;" />
        <button id="lrc-off-plus" style="width:22px;height:22px;border-radius:4px;border:1px solid rgba(255,255,255,0.1);background:none;color:#888;font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;">+</button>
        <button id="lrc-apply-offset" style="flex:1;padding:3px 8px;border-radius:5px;border:1px solid rgba(255,255,255,0.1);background:none;color:#a78bfa;font-size:11px;cursor:pointer;">应用</button>
      </div>
      <!-- 歌词列表 -->
      <div id="lrc-lines" style="flex:1;overflow-y:auto;padding:4px 0;"></div>
      <!-- 底部操作 -->
      <div style="padding:10px 12px; border-top:1px solid rgba(255,255,255,0.07); display:flex; gap:8px; flex-shrink:0;">
        <span style="font-size:10px;color:#444;flex:1;line-height:1.5;">Enter 定位此行<br>↑↓ 切换行</span>
        <button id="lrc-save-btn" style="padding:7px 18px;border-radius:7px;background:#a78bfa;border:none;color:#0d0d0f;font-size:12px;font-weight:700;cursor:pointer;">保存</button>
      </div>
    </div>
  )}


  <!-- 列表页 -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
    <div class="mb-12 reveal">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight mb-2">在听</h1>
      <p class="text-sm text-gray-400 dark:text-gray-500">最近在循环的歌。点开听，歌词会跟上来。</p>
    </div>

    <div class="divide-y divide-gray-100 dark:divide-white/[0.06]">
      {songs.map((song, i) => (
        <button
          class={`song-row w-full text-left py-5 group cursor-pointer reveal reveal-delay-${Math.min(i+1,5)} hover:bg-gray-50/50 dark:hover:bg-white/[0.02] -mx-2 px-2 rounded-lg transition-colors`}
          data-idx={i}>
          <div class="flex items-center gap-4">
            <div class="shrink-0 w-12 h-12 rounded-lg overflow-hidden bg-gray-100 dark:bg-white/[0.06] flex items-center justify-center">
              {song.youtubeId !== 'FILL_IN_YOUTUBE_ID'
                ? <img src={`https://i.ytimg.com/vi/${song.youtubeId}/hqdefault.jpg`} alt={song.title} class="w-full h-full object-cover" loading="lazy" />
                : <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"/>
                  </svg>
              }
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-base font-medium text-gray-900 dark:text-white leading-snug">{song.title}</p>
              <p class="text-sm text-gray-400 dark:text-gray-500 mt-0.5">{song.artist} · {song.year}</p>
              {song.note && <p class="text-xs text-gray-400 dark:text-gray-600 mt-1.5 italic">"{song.note}"</p>}
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 dark:text-gray-700 group-hover:text-violet-400 dark:group-hover:text-violet-600 shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </button>
      ))}
    </div>
  </div>

</BaseLayout>

<!-- 把歌曲数据注入 window -->
<script define:vars={{ songsData: songs }}>
  window.__songsData__ = songsData;
</script>

<!-- YouTube IFrame API -->
<script is:inline>
  (function(){
    var s = document.createElement('script');
    s.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(s);
  })();
</script>

<script>
  // ---- 类型声明 ----
  declare const window: Window & {
    __songsData__: Array<{id:string;title:string;artist:string;youtubeId:string;lyrics:string}>;
    onYouTubeIframeAPIReady: () => void;
    YT: any;
  };

  // ---- LRC 解析 ----
  function parseLRC(lrc: string) {
    return lrc.split('\n').map(line => {
      const m = line.match(/^\[(\d+):(\d+\.\d+)\](.*)/);
      if (!m) return null;
      return { time: parseInt(m[1]) * 60 + parseFloat(m[2]), text: m[3].trim() };
    }).filter(Boolean) as Array<{time:number; text:string}>;
  }

  function findCurrentLine(lines: Array<{time:number;text:string}>, t: number) {
    let idx = 0;
    for (let i = 0; i < lines.length; i++) {
      if (lines[i].time <= t) idx = i;
      else break;
    }
    return idx;
  }

  // ---- DOM ----
  const overlay     = document.getElementById('music-overlay')!;
  const lyricsInner = document.getElementById('lyrics-inner')!;
  const titleEl     = document.getElementById('overlay-title')!;
  const artistEl    = document.getElementById('overlay-artist')!;
  const closeBtn    = document.getElementById('overlay-close')!;
  const prevBtn     = document.getElementById('prev-song') as HTMLButtonElement;
  const nextBtn     = document.getElementById('next-song') as HTMLButtonElement;

  // ---- YouTube ----
  let ytPlayer: any = null;
  let ytReady = false;
  let pendingIdx = -1;

  window.onYouTubeIframeAPIReady = () => {
    ytReady = true;
    ytPlayer = new window.YT.Player('yt-player', {
      width: '280', height: '158',
      playerVars: { autoplay: 0, controls: 1, rel: 0, modestbranding: 1 },
    });
    if (pendingIdx >= 0) loadVideo(pendingIdx);
  };

  function loadVideo(idx: number) {
    const song = window.__songsData__[idx];
    if (!song || song.youtubeId === 'FILL_IN_YOUTUBE_ID') return;
    if (ytPlayer?.loadVideoById) ytPlayer.loadVideoById(song.youtubeId);
    else pendingIdx = idx;
  }

  // ---- 歌词 ----
  let syncTimer: ReturnType<typeof setInterval> | null = null;
  let curIdx = -1;
  let curLineIdx = -1;
  let curLines: Array<{time:number;text:string}> = [];

  const LINE_H = 42; // px，与下面的 padding/font 对应

  function renderLyrics(lines: Array<{time:number;text:string}>) {
    lyricsInner.innerHTML = lines.map((l, i) =>
      `<div class="ly" data-i="${i}" style="text-align:center;padding:9px 28px;font-size:1rem;line-height:1.6;color:rgba(255,255,255,0.2);transition:color .3s,font-size .3s,font-weight .3s;">${l.text || '·'}</div>`
    ).join('');
    curLineIdx = -1;
    lyricsInner.style.transform = 'translateY(0)';
  }

  function highlightLine(idx: number) {
    if (idx === curLineIdx) return;
    curLineIdx = idx;
    lyricsInner.querySelectorAll<HTMLElement>('.ly').forEach((el, i) => {
      const d = Math.abs(i - idx);
      el.style.color = d === 0 ? 'rgba(255,255,255,1)' : d === 1 ? 'rgba(255,255,255,0.4)' : 'rgba(255,255,255,0.15)';
      el.style.fontSize = d === 0 ? '1.0625rem' : '1rem';
      el.style.fontWeight = d === 0 ? '500' : '400';
    });
    // 当前行居中
    lyricsInner.style.transform = `translateY(${-idx * LINE_H}px)`;
  }

  // ---- 打开/关闭 ----
  function openSong(idx: number) {
    const all = window.__songsData__;
    const song = all[idx];
    if (!song) return;
    curIdx = idx;

    titleEl.textContent = song.title;
    artistEl.textContent = song.artist;
    curLines = parseLRC(song.lyrics);
    renderLyrics(curLines);

    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    document.body.style.overflow = 'hidden';
    prevBtn.disabled = idx === 0;
    nextBtn.disabled = idx === all.length - 1;

    loadVideo(idx);

    // 同步歌词
    if (syncTimer) clearInterval(syncTimer);
    syncTimer = setInterval(() => {
      if (!ytPlayer?.getCurrentTime) return;
      const t = ytPlayer.getCurrentTime();
      highlightLine(findCurrentLine(curLines, t));
      // dev panel 时间显示
      if (import.meta.env.DEV) devUpdateTime(t);
    }, 100);

    // dev panel
    if (import.meta.env.DEV) devOpenSong(song.title, curLines);
  }

  function closeOverlay() {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
    document.body.style.overflow = '';
    if (syncTimer) clearInterval(syncTimer);
    ytPlayer?.pauseVideo?.();
    if (import.meta.env.DEV) devClosePanel();
  }

  // ---- 事件绑定 ----
  document.querySelectorAll<HTMLButtonElement>('.song-row').forEach((row, i) => {
    row.addEventListener('click', () => openSong(i));
  });
  closeBtn.addEventListener('click', closeOverlay);
  prevBtn.addEventListener('click', () => openSong(curIdx - 1));
  nextBtn.addEventListener('click', () => openSong(curIdx + 1));
  document.addEventListener('keydown', e => {
    if (overlay.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeOverlay();
  });

  // Scroll reveal
  const obs = new IntersectionObserver(
    es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } }),
    { threshold: 0.05 }
  );
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

  // ---- DEV: LRC 校对面板 ----
  if (import.meta.env.DEV) {
    const devPanel    = document.getElementById('lrc-dev-panel') as HTMLElement | null;
    const devTimeEl   = document.getElementById('lrc-time-now') as HTMLElement | null;
    const devLabel    = document.getElementById('lrc-song-label') as HTMLElement | null;
    const devLines    = document.getElementById('lrc-lines') as HTMLElement | null;
    const devOffInput = document.getElementById('lrc-offset') as HTMLInputElement | null;
    const devToggle   = document.getElementById('lrc-edit-toggle') as HTMLButtonElement | null;
    const devSaveBtn  = document.getElementById('lrc-save-btn') as HTMLButtonElement | null;

    let devActiveRow = -1;
    let devPanelOpen = false;

    function devFmt(t: number) {
      const m = Math.floor(t / 60);
      const s = t % 60;
      return `${m}:${s.toFixed(1).padStart(4,'0')}`;
    }
    function devFmtFull(t: number) {
      const m = Math.floor(t / 60);
      const s = t % 60;
      return `${String(m).padStart(2,'0')}:${s.toFixed(2).padStart(5,'0')}`;
    }

    function devBuildLines() {
      if (!devLines) return;
      devLines.innerHTML = curLines.map((l, i) =>
        `<div class="dev-row" data-i="${i}" style="
          display:flex;align-items:center;gap:0;padding:0 8px 0 12px;
          height:36px;cursor:pointer;border-left:3px solid transparent;
          transition:background .1s;
        ">
          <span class="dev-ts" data-i="${i}" style="
            font-family:monospace;font-size:10px;color:#555;width:60px;
            flex-shrink:0;cursor:pointer;padding:2px 4px;border-radius:3px;
          ">[${devFmtFull(l.time)}]</span>
          <span style="flex:1;font-size:12px;color:#888;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 6px;">${l.text || '·'}</span>
          <button class="dev-set" data-i="${i}" style="
            font-size:10px;padding:2px 6px;border-radius:4px;
            border:1px solid rgba(255,255,255,0.1);background:none;
            color:#555;cursor:pointer;white-space:nowrap;flex-shrink:0;
          ">↩</button>
        </div>`
      ).join('');

      devLines.querySelectorAll<HTMLElement>('.dev-row').forEach(row => {
        row.addEventListener('click', () => devSetActive(parseInt(row.dataset.i!)));
      });
      devLines.querySelectorAll<HTMLElement>('.dev-ts').forEach(ts => {
        ts.addEventListener('click', e => {
          e.stopPropagation();
          ytPlayer?.seekTo?.(curLines[parseInt(ts.dataset.i!)].time, true);
        });
      });
      devLines.querySelectorAll<HTMLElement>('.dev-set').forEach(btn => {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          devSetTimestamp(parseInt(btn.dataset.i!));
        });
      });
    }

    function devSetActive(i: number) {
      if (devActiveRow >= 0) {
        const prev = devLines?.querySelector<HTMLElement>(`.dev-row[data-i="${devActiveRow}"]`);
        if (prev) { prev.style.background = ''; prev.style.borderLeftColor = 'transparent'; }
      }
      devActiveRow = i;
      const el = devLines?.querySelector<HTMLElement>(`.dev-row[data-i="${i}"]`);
      if (el) {
        el.style.background = 'rgba(167,139,250,0.08)';
        el.style.borderLeftColor = '#a78bfa';
        el.scrollIntoView({ block: 'nearest' });
      }
    }

    function devSetTimestamp(i: number) {
      const t = ytPlayer?.getCurrentTime?.() ?? 0;
      curLines[i].time = Math.round(t * 100) / 100;
      const ts = devLines?.querySelector<HTMLElement>(`.dev-ts[data-i="${i}"]`);
      if (ts) ts.textContent = `[${devFmtFull(curLines[i].time)}]`;
    }

    function devUpdateTime(t: number) {
      if (devTimeEl) devTimeEl.textContent = devFmt(t);
      // also keep dev active row in sync with playback
      const i = findCurrentLine(curLines, t);
      if (i !== devActiveRow) devSetActive(i);
    }

    function devOpenSong(title: string, lines: Array<{time:number;text:string}>) {
      if (devLabel) devLabel.textContent = title;
      devBuildLines();
      if (devPanelOpen && devPanel) devPanel.style.display = 'flex';
    }

    function devClosePanel() {
      if (devPanel) devPanel.style.display = 'none';
      devPanelOpen = false;
      if (devToggle) devToggle.style.color = '';
    }

    // toggle button
    devToggle?.addEventListener('click', () => {
      devPanelOpen = !devPanelOpen;
      if (devPanel) devPanel.style.display = devPanelOpen ? 'flex' : 'none';
      if (devToggle) devToggle.style.color = devPanelOpen ? '#a78bfa' : '';
      if (devPanelOpen) devBuildLines();
    });

    // offset controls
    document.getElementById('lrc-off-minus')?.addEventListener('click', () => {
      if (devOffInput) devOffInput.value = (parseFloat(devOffInput.value) - 0.5).toFixed(1);
    });
    document.getElementById('lrc-off-plus')?.addEventListener('click', () => {
      if (devOffInput) devOffInput.value = (parseFloat(devOffInput.value) + 0.5).toFixed(1);
    });
    document.getElementById('lrc-apply-offset')?.addEventListener('click', () => {
      const off = parseFloat(devOffInput?.value ?? '0') || 0;
      if (off === 0) return;
      curLines.forEach(l => l.time = Math.max(0, Math.round((l.time + off) * 100) / 100));
      if (devOffInput) devOffInput.value = '0';
      devBuildLines();
      // also re-render main lyrics display
      renderLyrics(curLines);
    });

    // save
    devSaveBtn?.addEventListener('click', async () => {
      const song = window.__songsData__[curIdx];
      if (!song) return;
      const lrc = curLines.map(l => {
        const m = Math.floor(l.time / 60);
        const s = l.time % 60;
        return `[${String(m).padStart(2,'0')}:${s.toFixed(2).padStart(5,'0')}]${l.text}`;
      }).join('\n');
      devSaveBtn.textContent = '保存中…';
      devSaveBtn.style.opacity = '0.6';
      try {
        const r = await fetch('/api/lyrics', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ songId: song.id, lyrics: lrc }),
        });
        devSaveBtn.textContent = r.ok ? '已保存 ✓' : '失败';
        devSaveBtn.style.background = r.ok ? '#34d399' : '#f87171';
      } catch { devSaveBtn.textContent = '出错了'; }
      setTimeout(() => {
        devSaveBtn.textContent = '保存';
        devSaveBtn.style.opacity = '1';
        devSaveBtn.style.background = '#a78bfa';
      }, 2000);
    });

    // keyboard shortcuts in dev panel
    document.addEventListener('keydown', e => {
      if (!devPanelOpen || overlay.classList.contains('hidden')) return;
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'INPUT') return;

      if (e.code === 'ArrowUp') {
        e.preventDefault();
        const i = Math.max(0, devActiveRow - 1);
        devSetActive(i);
        ytPlayer?.seekTo?.(curLines[i].time, true);
      }
      if (e.code === 'ArrowDown') {
        e.preventDefault();
        const i = Math.min(curLines.length - 1, devActiveRow + 1);
        devSetActive(i);
        ytPlayer?.seekTo?.(curLines[i].time, true);
      }
      if (e.code === 'Enter') {
        e.preventDefault();
        if (devActiveRow >= 0) {
          devSetTimestamp(devActiveRow);
          const next = Math.min(curLines.length - 1, devActiveRow + 1);
          devSetActive(next);
        }
      }
    });
  }

</script>
