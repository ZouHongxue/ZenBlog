---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const allTags = [...new Set(allPosts.flatMap(p => p.data.tags || []))];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="博客" description="所有文章">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
    <div class="mb-12 reveal">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight mb-1">博客</h1>
      <p class="text-sm text-gray-400 dark:text-gray-500">{allPosts.length} 篇文章</p>
    </div>

    <!-- Tags filter -->
    <div class="flex flex-wrap gap-2 mb-10 reveal reveal-delay-1" id="tag-filter">
      <button data-tag="all"
        class="tag-btn active text-xs px-3 py-1.5 rounded-md border font-medium tracking-wide transition-all duration-150
          border-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
        全部
      </button>
      {allTags.map(tag => (
        <button data-tag={tag}
          class="tag-btn text-xs px-3 py-1.5 rounded-md border font-medium tracking-wide transition-all duration-150
            border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-400
            hover:border-indigo-300 dark:hover:border-indigo-700 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50/50 dark:hover:bg-indigo-950/30">
          {tag}
        </button>
      ))}
    </div>

    <!-- Posts list -->
    <div class="divide-y divide-gray-100 dark:divide-white/[0.06]" id="posts-list">
      {allPosts.map((post, i) => {
        const date = new Date(post.data.pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
        const tags = post.data.tags?.join(',') || '';
        const delayClass = `reveal-delay-${Math.min(i + 1, 5)}`;
        return (
          <a href={`${base}blog/${post.slug}`}
            data-tags={tags}
            class={`post-card group flex items-start gap-5 py-5 transition-colors duration-150 reveal ${delayClass}`}>
            <time class="text-xs text-gray-400 dark:text-gray-600 shrink-0 mt-1 w-28 tabular-nums">{date}</time>
            <div class="flex-1 min-w-0">
              <h2 class="font-medium text-gray-800 dark:text-gray-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-150 mb-1 leading-snug">
                {post.data.title}
              </h2>
              <p class="text-sm text-gray-400 dark:text-gray-500 line-clamp-1 leading-relaxed">{post.data.description}</p>
              {post.data.tags && (
                <div class="flex gap-1.5 mt-2.5">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-gray-100 dark:bg-white/[0.06] text-gray-500 dark:text-gray-400">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 dark:text-gray-700 group-hover:text-indigo-400 dark:group-hover:text-indigo-600 shrink-0 mt-1 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.post-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag!;
      buttons.forEach(b => {
        b.classList.remove('active', 'border-indigo-400', 'bg-indigo-50', 'dark:bg-indigo-950/60', 'text-indigo-600', 'dark:text-indigo-400');
        b.classList.add('border-gray-200', 'dark:border-white/10', 'text-gray-500', 'dark:text-gray-400');
      });
      btn.classList.add('active', 'border-indigo-400', 'bg-indigo-50', 'dark:bg-indigo-950/60', 'text-indigo-600', 'dark:text-indigo-400');
      btn.classList.remove('border-gray-200', 'dark:border-white/10', 'text-gray-500', 'dark:text-gray-400');

      cards.forEach(card => {
        const cardTags = card.dataset.tags || '';
        card.style.display = (tag === 'all' || cardTags.includes(tag)) ? '' : 'none';
      });
    });
  });

  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
