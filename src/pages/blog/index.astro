---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Collect all tags
const allTags = [...new Set(allPosts.flatMap(p => p.data.tags || []))];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="博客" description="所有文章">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">博客</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-10">共 {allPosts.length} 篇文章</p>

    <!-- Tags filter -->
    <div class="flex flex-wrap gap-2 mb-10" id="tag-filter">
      <button data-tag="all"
        class="tag-btn active text-sm px-3.5 py-1.5 rounded-full border font-medium transition-all
          border-indigo-500 bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400">
        全部
      </button>
      {allTags.map(tag => (
        <button data-tag={tag}
          class="tag-btn text-sm px-3.5 py-1.5 rounded-full border font-medium transition-all
            border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400
            hover:border-indigo-400 dark:hover:border-indigo-600 hover:text-indigo-600 dark:hover:text-indigo-400">
          {tag}
        </button>
      ))}
    </div>

    <!-- Posts list -->
    <div class="space-y-3" id="posts-list">
      {allPosts.map(post => {
        const date = new Date(post.data.pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
        const tags = post.data.tags?.join(',') || '';
        return (
          <a href={`${base}blog/${post.slug}`}
            data-tags={tags}
            class="post-card group flex items-start gap-4 p-5 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-indigo-300 dark:hover:border-indigo-700 bg-white dark:bg-gray-900/40 hover:bg-indigo-50/20 dark:hover:bg-indigo-950/20 transition-all">
            <time class="text-xs text-gray-400 dark:text-gray-500 shrink-0 mt-1.5 w-24">{date}</time>
            <div class="flex-1 min-w-0">
              <h2 class="font-medium text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-1">
                {post.data.title}
              </h2>
              <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-1">{post.data.description}</p>
              {post.data.tags && (
                <div class="flex gap-1.5 mt-2">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.post-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag!;
      buttons.forEach(b => {
        b.classList.remove('active', 'border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-950', 'text-indigo-600', 'dark:text-indigo-400');
        b.classList.add('border-gray-200', 'dark:border-gray-700', 'text-gray-600', 'dark:text-gray-400');
      });
      btn.classList.add('active', 'border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-950', 'text-indigo-600', 'dark:text-indigo-400');
      btn.classList.remove('border-gray-200', 'dark:border-gray-700', 'text-gray-600', 'dark:text-gray-400');

      cards.forEach(card => {
        const cardTags = card.dataset.tags || '';
        card.style.display = (tag === 'all' || cardTags.includes(tag)) ? '' : 'none';
      });
    });
  });
</script>
