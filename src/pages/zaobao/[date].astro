---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const zaobaoDir = join(process.cwd(), 'src/data/zaobao');
  const files = readdirSync(zaobaoDir).filter(f => f.endsWith('.html'));
  return files.map(f => ({ params: { date: f.replace('.html', '') } }));
}

const { date } = Astro.params;
const zaobaoDir = join(process.cwd(), 'src/data/zaobao');
const rawHtml = readFileSync(join(zaobaoDir, `${date}.html`), 'utf-8');

// 日期格式化（仅用于面包屑）
const d = new Date(date);
const dateStr = d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title={`早报 ${date}`} description={`财经早报 ${dateStr}`}>

  <!-- 面包屑导航 -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-3 flex items-center gap-3">
    <a href={`${base}zaobao`}
      class="inline-flex items-center gap-1.5 text-xs text-gray-400 dark:text-gray-600 hover:text-amber-500 transition-colors group">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      早报列表
    </a>
    <span class="text-gray-200 dark:text-gray-800">·</span>
    <span class="text-xs text-gray-400 dark:text-gray-600">{dateStr}</span>
  </div>

  <!-- 早报正文：iframe 完全隔离 CSS，原版样式一比一还原 -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
    <iframe
      id="zaobao-frame"
      srcdoc={rawHtml}
      title={`财经早报 ${date}`}
      scrolling="no"
      style="width:100%; border:none; display:block; min-height:800px;"
    />
  </div>

</BaseLayout>

<script>
  // srcdoc 与父页面同源，load 后直接读 contentDocument 高度，最可靠
  const frame = document.getElementById('zaobao-frame') as HTMLIFrameElement | null;
  if (frame) {
    function fitFrame() {
      try {
        const doc = frame!.contentDocument || frame!.contentWindow?.document;
        if (!doc) return;
        // 先重置高度让内容自然撑开，再测量
        frame!.style.height = '0px';
        const h = Math.max(
          doc.documentElement.scrollHeight,
          doc.documentElement.offsetHeight,
          doc.body?.scrollHeight ?? 0
        );
        frame!.style.height = h + 'px';
      } catch {}
    }
    frame.addEventListener('load', () => {
      fitFrame();
      // 字体/图片异步加载完后再修正一次
      setTimeout(fitFrame, 300);
      setTimeout(fitFrame, 1000);
    });
  }
</script>
