---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const zaobaoDir = join(process.cwd(), 'src/data/zaobao');
  const files = readdirSync(zaobaoDir).filter(f => f.endsWith('.html'));
  return files.map(f => ({ params: { date: f.replace('.html', '') } }));
}

const { date } = Astro.params;
const zaobaoDir = join(process.cwd(), 'src/data/zaobao');
let rawHtml = readFileSync(join(zaobaoDir, `${date}.html`), 'utf-8');

// 在 </body> 前注入高度上报脚本。
// 用 document.fonts.ready 确保字体加载完毕后再测量，是最准确的时机。
const heightScript = `
<script>
(function() {
  function send() {
    var h = Math.max(
      document.documentElement.scrollHeight,
      document.documentElement.offsetHeight,
      document.body ? document.body.scrollHeight : 0
    );
    parent.postMessage({ type: 'zaobao-h', h: h }, '*');
  }
  // 1) 字体 ready 后测量
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(function() { send(); setTimeout(send, 200); });
  }
  // 2) window load 作为保底
  window.addEventListener('load', function() { send(); setTimeout(send, 500); });
  // 3) 持续监听 body 高度变化（图片等异步内容）
  if (window.ResizeObserver && document.body) {
    new ResizeObserver(send).observe(document.body);
  }
})();
<\/script>
`;
rawHtml = rawHtml.replace(/<\/body>/i, heightScript + '</body>');

// 日期格式化（仅用于面包屑）
const d = new Date(date);
const dateStr = d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title={`早报 ${date}`} description={`财经早报 ${dateStr}`}>

  <!-- 面包屑导航 -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-3 flex items-center gap-3">
    <a href={`${base}zaobao`}
      class="inline-flex items-center gap-1.5 text-xs text-gray-400 dark:text-gray-600 hover:text-amber-500 transition-colors group">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      早报列表
    </a>
    <span class="text-gray-200 dark:text-gray-800">·</span>
    <span class="text-xs text-gray-400 dark:text-gray-600">{dateStr}</span>
  </div>

  <!-- 早报正文：iframe 完全隔离 CSS，原版样式一比一还原 -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
    <iframe
      id="zaobao-frame"
      srcdoc={rawHtml}
      title={`财经早报 ${date}`}
      scrolling="no"
      style="width:100%; border:none; display:block; min-height:600px;"
    />
  </div>

</BaseLayout>

<script>
  window.addEventListener('message', function(e) {
    if (!e.data || e.data.type !== 'zaobao-h') return;
    var frame = document.getElementById('zaobao-frame') as HTMLIFrameElement | null;
    if (frame && e.data.h > 0) {
      // 只增不减（防止 ResizeObserver 中途测到偏小值）
      var cur = parseInt(frame.style.height) || 0;
      if (e.data.h > cur) frame.style.height = e.data.h + 'px';
    }
  });
</script>
