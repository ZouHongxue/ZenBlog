---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';
const isDev = import.meta.env.DEV;

const zaobaoDir = join(process.cwd(), 'src/data/zaobao');
const files = readdirSync(zaobaoDir)
  .filter(f => f.endsWith('.html'))
  .sort().reverse();

function decodeHtml(s: string) {
  return s.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
}

function parsePreview(date: string) {
  try {
    const html = readFileSync(join(zaobaoDir, `${date}.html`), 'utf-8');
    const sections = [...html.matchAll(/<div class="section-title">(.*?)<\/div>/gs)]
      .map(m => decodeHtml(m[1].replace(/<[^>]*>/g, '').trim()));
    const headlines = [...html.matchAll(/class="item-title">\s*(?:<a[^>]*>)?(.*?)(?:<\/a>)?\s*(?:<span[^>]*>.*?<\/span>)?\s*<\/div>/gs)]
      .map(m => decodeHtml(m[1].replace(/<[^>]*>/g, '').trim()))
      .filter(Boolean)
      .slice(0, 4);
    return { sections, headlines };
  } catch { return { sections: [], headlines: [] }; }
}

const briefs = files.map(f => {
  const date = f.replace('.html', '');
  const { sections, headlines } = parsePreview(date);
  return { date, sections, headlines };
});

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="早报" description="每日财经与 AI 摘要。">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-14">

    <div class="mb-10 reveal">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold text-amber-500 tracking-wider uppercase">Daily Brief</span>
      </div>
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight">早报</h1>
        {isDev && (
          <button id="sync-zaobao-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-dashed border-amber-400 dark:border-amber-600 text-xs text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/30 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            从桌面同步
          </button>
        )}
      </div>
      <p class="text-sm text-gray-400 dark:text-gray-500 mt-2">AI、科技股、宏观、红利资产每日摘要。</p>
    </div>

    <div class="divide-y divide-gray-100 dark:divide-white/[0.06]">
      {briefs.map((b, i) => {
        const d = new Date(b.date);
        const dateStr = d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
        const weekday = d.toLocaleDateString('zh-CN', { weekday: 'long' });
        return (
          <a
            href={`${base}zaobao/${b.date}`}
            class={`group flex items-start gap-5 py-6 hover:bg-amber-50/50 dark:hover:bg-amber-950/10 -mx-3 px-3 rounded-xl transition-colors reveal reveal-delay-${Math.min(i+1,5)}`}>

            <!-- 日期 -->
            <div class="shrink-0 w-14 text-center pt-0.5">
              <div class="text-2xl font-bold text-amber-500 tabular-nums leading-none">{d.getDate()}</div>
              <div class="text-xs text-gray-400 dark:text-gray-600 mt-0.5">{d.toLocaleDateString('zh-CN', { month: 'short' })}</div>
              <div class="text-xs text-gray-300 dark:text-gray-700 mt-0.5">{weekday.replace('星期', '')}</div>
            </div>

            <!-- 内容 -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2">
                <h2 class="text-base font-semibold text-gray-800 dark:text-gray-200 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                  财经早报 · {dateStr}
                </h2>
              </div>
              {b.sections.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mb-2">
                  {b.sections.map(s => (
                    <span class="text-xs text-amber-600 dark:text-amber-500 bg-amber-50 dark:bg-amber-950/30 px-2 py-0.5 rounded-full">{s}</span>
                  ))}
                </div>
              )}
              {b.headlines.length > 0 && (
                <ul class="space-y-0.5">
                  {b.headlines.map(h => (
                    <li class="text-xs text-gray-500 dark:text-gray-500 truncate before:content-['·'] before:mr-1.5 before:text-amber-400">{h}</li>
                  ))}
                </ul>
              )}
            </div>

            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 dark:text-gray-700 group-hover:text-amber-400 shrink-0 mt-1 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        );
      })}
    </div>

    {briefs.length === 0 && (
      <div class="text-center py-20 text-gray-400 dark:text-gray-600 text-sm">暂无早报</div>
    )}
  </div>
</BaseLayout>

<script>
  const obs = new IntersectionObserver(
    es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } }),
    { threshold: 0.05 }
  );
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

  // Dev: 同步桌面早报
  const syncBtn = document.getElementById('sync-zaobao-btn') as HTMLButtonElement | null;
  syncBtn?.addEventListener('click', async () => {
    syncBtn.textContent = '同步中…';
    syncBtn.style.opacity = '0.6';
    try {
      const r = await fetch('/api/sync-zaobao', { method: 'POST' });
      const data = await r.json();
      if (data.ok) {
        syncBtn.textContent = data.copied.length > 0
          ? `已同步并提交 ${data.copied.length} 份 — 记得 push ✓`
          : '已是最新 ✓';
        syncBtn.style.color = '#16a34a';
        syncBtn.style.borderColor = '#16a34a';
        if (data.copied.length > 0) setTimeout(() => location.reload(), 800);
      } else {
        syncBtn.textContent = '同步失败';
        syncBtn.style.color = '#dc2626';
        console.error(data.error);
      }
    } catch (e) {
      syncBtn.textContent = '出错了';
      console.error(e);
    }
    setTimeout(() => {
      if (syncBtn) {
        syncBtn.textContent = '从桌面同步';
        syncBtn.style.opacity = '1';
        syncBtn.style.color = '';
        syncBtn.style.borderColor = '';
      }
    }, 3000);
  });
</script>
