---
import BaseLayout from '../layouts/BaseLayout.astro';
import ideas from '../data/ideas.json';

const sorted = [...ideas].reverse(); // 最新在前
---
<BaseLayout title="闪念" description="路上冒出来的想法，随手记下。不一定成熟，但值得留着。">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">

    <div class="mb-12 reveal">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight mb-2">闪念</h1>
      <p class="text-sm text-gray-400 dark:text-gray-500">路上冒出来的想法，随手记下。不一定成熟，但值得留着。</p>
    </div>

    <div class="divide-y divide-gray-100 dark:divide-white/[0.06]">
      {sorted.map((idea, i) => (
        <div class={`py-6 reveal reveal-delay-${Math.min(i + 1, 5)}`}>
          <p class="text-base text-gray-800 dark:text-gray-100 leading-relaxed mb-3">
            {idea.text}
          </p>
          <div class="flex items-center gap-3">
            {idea.context && (
              <span class="text-xs text-gray-400 dark:text-gray-500">{idea.context}</span>
            )}
            {idea.context && <span class="text-gray-200 dark:text-gray-700">·</span>}
            <span class="text-xs text-violet-400 dark:text-violet-600 tabular-nums">
              {new Date(idea.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
            {idea.tags.map(tag => (
              <span class="text-xs text-violet-300 dark:text-violet-700">#{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
    }),
    { threshold: 0.05 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
