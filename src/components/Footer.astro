---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="border-t border-gray-200 dark:border-gray-800 mt-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500 dark:text-gray-400">
    <span>© {year} Zen · 用 Astro 构建</span>
    <div class="flex items-center gap-4">
      <a href="https://github.com/ZouHongxue" target="_blank" rel="noopener" class="hover:text-gray-900 dark:hover:text-white transition-colors">GitHub</a>
      <a href={`${base}rss.xml`} class="hover:text-gray-900 dark:hover:text-white transition-colors">RSS</a>
    </div>
  </div>
</footer>
