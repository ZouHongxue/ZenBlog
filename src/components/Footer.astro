---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="border-t border-gray-100 dark:border-white/[0.06] mt-24">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-400 dark:text-gray-500">
    <span class="tracking-wide">© {year} Zen</span>
    <div class="flex items-center gap-5">
      <a href="https://github.com/ZouHongxue" target="_blank" rel="noopener" class="hover:text-gray-700 dark:hover:text-gray-300 transition-colors">GitHub</a>
      <a href={`${base}rss.xml`} class="hover:text-gray-700 dark:hover:text-gray-300 transition-colors">RSS</a>
    </div>
  </div>
</footer>
